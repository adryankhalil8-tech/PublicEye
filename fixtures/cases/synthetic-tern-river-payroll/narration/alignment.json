{
  "schemaVersion": 1,
  "kind": "narration-alignment",
  "narrationId": "narr-synthetic-tern-river-payroll",
  "alignmentSource": "PER_UNIT_SYNTHESIS",
  "tool": "per-unit SAPI takes joined with exact silences; word times interpolated",
  "createdAt": "2026-09-30T23:50:58.187Z",
  "audioDurationSec": 101.372,
  "segments": [
    {
      "id": "seg-001",
      "narrationUnitId": "nu-001",
      "startSec": 0,
      "endSec": 8.308,
      "durationSec": 8.308,
      "text": "On the morning of November 12, 1954, the weekly payroll of the Tern River Mill was gone from the office safe."
    },
    {
      "id": "seg-002",
      "narrationUnitId": "nu-002",
      "startSec": 8.308,
      "endSec": 15.296,
      "durationSec": 6.988,
      "text": "The police report noted one detail that would shape everything after: no signs that the safe had been forced."
    },
    {
      "id": "seg-003",
      "narrationUnitId": "nu-003",
      "startSec": 16.096,
      "endSec": 22.674,
      "durationSec": 6.578,
      "text": "The cash, eighteen thousand four hundred dollars, had been locked inside the afternoon before."
    },
    {
      "id": "seg-004",
      "narrationUnitId": "nu-004",
      "startSec": 22.674,
      "endSec": 29.028,
      "durationSec": 6.354,
      "text": "At trial, the mill's office manager testified that at least three employees knew the combination."
    },
    {
      "id": "seg-005",
      "narrationUnitId": "nu-005",
      "startSec": 29.028,
      "endSec": 37.061,
      "durationSec": 8.033,
      "text": "Police focused on one of them. They alleged that the bookkeeper, Oren Tallis, had opened the safe himself."
    },
    {
      "id": "seg-006",
      "narrationUnitId": "nu-006",
      "startSec": 37.061,
      "endSec": 39.531,
      "durationSec": 2.47,
      "text": "Tallis denied taking the money."
    },
    {
      "id": "seg-007",
      "narrationUnitId": "nu-007",
      "startSec": 39.531,
      "endSec": 44.219,
      "durationSec": 4.688,
      "text": "In December 1954, he was charged with larceny."
    },
    {
      "id": "seg-008",
      "narrationUnitId": "nu-008",
      "startSec": 44.819,
      "endSec": 56.597,
      "durationSec": 11.778,
      "text": "The night watchman testified that he saw a light in the office window at about two in the morning. The local paper, the day after the theft, had reported that light shortly after midnight."
    },
    {
      "id": "seg-009",
      "narrationUnitId": "nu-009",
      "startSec": 56.597,
      "endSec": 62.31,
      "durationSec": 5.713,
      "text": "The case would turn on what the prosecution could prove, not on what it could suggest."
    },
    {
      "id": "seg-010",
      "narrationUnitId": "nu-010",
      "startSec": 62.91,
      "endSec": 73.968,
      "durationSec": 11.058,
      "text": "In March 1955, the jury acquitted Tallis. The judge's written ruling put it plainly: \"Suspicion, however strong, is not proof.\""
    },
    {
      "id": "seg-011",
      "narrationUnitId": "nu-011",
      "startSec": 74.968,
      "endSec": 84.231,
      "durationSec": 9.263,
      "text": "Some online retellings say the case ended in a jail sentence. The court record says otherwise: the only person charged was acquitted."
    },
    {
      "id": "seg-012",
      "narrationUnitId": "nu-012",
      "startSec": 84.231,
      "endSec": 89.14,
      "durationSec": 4.909,
      "text": "As of April 1955, the payroll had not been recovered."
    },
    {
      "id": "seg-013",
      "narrationUnitId": "nu-013",
      "startSec": 89.14,
      "endSec": 95.093,
      "durationSec": 5.953,
      "text": "We found no record of anyone else being charged, though the surviving sources are thin."
    },
    {
      "id": "seg-014",
      "narrationUnitId": "nu-014",
      "startSec": 95.093,
      "endSec": 99.872,
      "durationSec": 4.779,
      "text": "Which leaves the question the court could not answer: who opened the safe?"
    }
  ],
