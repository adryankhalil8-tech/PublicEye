# Phase 0 needs NO environment variables. Everything runs locally and free.
#
# Paid providers are OPTIONAL and disabled by default. They are refused unless
# explicitly allowed here (see src/providers/policy.ts).
ALLOW_PAID_PROVIDERS=false

# Future optional keys (leave blank; never commit real values):
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
# COURTLISTENER_API_TOKEN=   # free account token, raises rate limits
